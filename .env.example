# Copy to .env (never commit .env). All values below are fictitious, for local development only.

# PostgreSQL (application database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=matriz
DB_USER=matriz
DB_PASSWORD=change-me-db

# PostgreSQL (Keycloak database, same server)
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# Keycloak bootstrap administrator (master realm)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-kc-admin

# Keycloak URL and the backend's confidential client (user sync)
KEYCLOAK_URL=http://localhost:8180
MATRIZ_BACKEND_CLIENT_SECRET=change-me-backend-secret

# Password of the demo users imported into the matriz realm
MATRIZ_DEMO_PASSWORD=password
